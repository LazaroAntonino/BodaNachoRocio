# Conexión a PostgreSQL (formato estándar)
# Ejemplo local: postgresql://usuario:contraseña@localhost:5432/boda_amor
DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/boda_amor

# Puerto del servidor Express (Nginx hará proxy a este puerto)
PORT=3001

# Cloudinary (subida de fotos sin firma)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
